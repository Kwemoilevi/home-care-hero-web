<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Caregiver - Home Care Hero</title><script src="https://cdn.tailwindcss.com"></script></head>
<body class="bg-[#fbf8f5]">
<div id="login" class="min-h-screen flex items-center justify-center p-6">
<div class="bg-white p-8 rounded-2xl shadow-xl w-full max-w-sm">
<h1 class="text-2xl font-bold">Caregiver Login</h1><p class="text-sm text-gray-500">Home Care Hero</p>
<input id="user" placeholder="Name e.g. Grace" class="w-full mt-6 px-4 py-3 rounded-xl border bg-gray-50">
<input id="pass" type="password" placeholder="Password" class="w-full mt-3 px-4 py-3 rounded-xl border bg-gray-50">
<button onclick="doLogin()" class="w-full mt-4 bg-black text-white py-3 rounded-xl font-bold">Login</button>
<p class="text-xs text-gray-400 mt-3 text-center">Demo: Grace / grace123 | Sarah / sarah123 | Moses / moses123</p><p id="err" class="text-sm text-red-500 mt-2 text-center"></p>
</div></div>
<div id="panel" class="hidden">
<nav class="bg-emerald-600 text-white px-6 py-4 flex justify-between"><b id="welcome">Caregiver</b><button onclick="localStorage.removeItem('hch_caregiver');location.reload()" class="text-xs bg-white/20 px-3 py-1 rounded-full">Logout</button></nav>
<div class="p-6 max-w-4xl mx-auto">
<div class="bg-white p-6 rounded-2xl border">
<h2 class="font-bold">My Assigned Bookings</h2><p class="text-xs text-gray-500">Update status so client sees live tracking</p>
<div id="myBookings" class="mt-4 space-y-3"></div>
</div>
<div class="mt-6 bg-black text-white p-6 rounded-2xl text-center">
<p class="text-sm">Share Live Location with Client</p>
<a id="shareBtn" href="#" target="_blank" class="mt-3 inline-block bg-[#25D366] px-6 py-3 rounded-full font-bold">📍 Share WhatsApp Live Location</a>
</div>
</div></div>
<script>
const CREDS={grace:'grace123',sarah:'sarah123',moses:'moses123'};
const NAMES={grace:'Grace N.',sarah:'Sarah K.',moses:'Moses O.'};
function doLogin(){
 let u=document.getElementById('user').value.toLowerCase().trim(); let p=document.getElementById('pass').value;
 if(CREDS[u]&&CREDS[u]===p){localStorage.setItem('hch_caregiver',u); show(u);} else {document.getElementById('err').textContent='Wrong! Use Grace / grace123';}
}
function show(u){
 document.getElementById('login').classList.add('hidden'); document.getElementById('panel').classList.remove('hidden');
 document.getElementById('welcome').textContent=NAMES[u]||u;
 document.getElementById('shareBtn').href=`https://wa.me/?text=Hi%2C%20I%20am%20${NAMES[u]}%20from%20Home%20Care%20Hero%2C%20I%20am%20on%20my%20way%20📍%20My%20live%20location%3A%20`;
 loadMy(u);
}
function loadMy(u){
 let myName=NAMES[u]; let arr=JSON.parse(localStorage.getItem('hch_bookings')||'[]');
 let mine=arr.filter(b=> (b.caregiver||'').toLowerCase().includes(myName.split(' ')[0].toLowerCase()) );
 if(mine.length===0) mine=arr.slice(0,3);
 let html='';
 mine.forEach(b=>{
  html+=`<div class="border p-4 rounded-xl flex justify-between items-center">
  <div><p class="font-bold">${b.id} - ${b.name}</p><p class="text-xs text-gray-500">${b.phone} • ${b.eta}</p><p class="text-xs">Status: <b>${b.status}</b></p></div>
  <div class="flex flex-col gap-1">
  <button onclick="updateStatus('${b.id}','on_the_way')" class="text-xs bg-yellow-400 px-3 py-1 rounded-full font-bold">On Way</button>
  <button onclick="updateStatus('${b.id}','arrived')" class="text-xs bg-emerald-500 text-white px-3 py-1 rounded-full font-bold">Arrived</button>
  <button onclick="updateStatus('${b.id}','care_started')" class="text-xs bg-black text-white px-3 py-1 rounded-full font-bold">Care Started</button>
  </div></div>`;
 });
 document.getElementById('myBookings').innerHTML=html||'<p class="text-center text-gray-400">No bookings assigned yet. Admin will assign in admin.html</p>';
}
function updateStatus(id,status){
 let arr=JSON.parse(localStorage.getItem('hch_bookings')||'[]'); let b=arr.find(x=>x.id===id); if(b){b.status=status; localStorage.setItem('hch_bookings',JSON.stringify(arr)); localStorage.setItem('hch_tracking_'+id,JSON.stringify(b)); alert('✅ Updated '+id+' to '+status+' - Client now sees live!'); loadMy(localStorage.getItem('hch_caregiver')); }
}
let saved=localStorage.getItem('hch_caregiver'); if(saved) show(saved);
</script></body></html>
